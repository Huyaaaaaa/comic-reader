# 后端配置示例
# 复制此文件为 backend/.env 并修改配置

# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug

# 数据库配置
DB_PATH=./data/comics.db

# 爬虫配置
CRAWLER_BASE_URL=https://example.com
CRAWLER_REQUEST_DELAY_MIN=2.0
CRAWLER_REQUEST_DELAY_MAX=5.0

# 缓存配置
CACHE_COVER_MAX=2000
CACHE_COVER_TARGET_SIZE_KB=50

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log
